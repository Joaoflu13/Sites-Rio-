// Sites Rio — devs encontram estabelecimentos do Rio sem site próprio.
// App usa a URL pooled (6543/pgbouncer); db push/seed/scripts usam a direta (5432).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PresenceClass {
  UNKNOWN // ainda não verificado pelo enrichment
  NO_SITE // nada encontrado — lead perfeito
  SOCIAL_ONLY // só Instagram/Facebook/linktree
  AGGREGATOR_ONLY // só iFood/TripAdvisor/Doctoralia etc.
  WEAK_SITE // "site" em construtor grátis (negocio.site, Wix grátis, Blogspot…)
  HAS_SITE // domínio próprio encontrado
}

enum LeadStatus {
  NOVO
  CONTATADO
  NEGOCIANDO
  FECHADO
  DESCARTADO
}

enum RunKind {
  RFB_IMPORT
  ENRICHMENT
}

enum RunStatus {
  RUNNING
  DONE
  FAILED
}

// Conta de um membro da equipe de vendas (criada pelo admin — sem auto-cadastro).
enum SequenceStatus {
  ACTIVE // na fila de envio
  REPLIED // respondeu (humano) — sequência para, vai para a aba Respostas
  FINISHED // 3 e-mails enviados sem resposta
  STOPPED // parada manual ou bloqueio (opt-out, supressão, CRM fechado)
  BOUNCED // e-mail voltou (endereço inválido)
  OPTED_OUT // respondeu SAIR / sem interesse
}

enum MessageDirection {
  OUT
  IN
}

enum ReplyKind {
  HUMAN // precisa de você
  OPT_OUT // SAIR / não tenho interesse
  BOUNCE // não entregue
  AUTO_REPLY // férias/ausência: adia a sequência
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique // sempre lowercase
  name         String
  passwordHash String
  role         Role                 @default(MEMBER)
  status       UserStatus           @default(ACTIVE)
  createdAt    DateTime             @default(now())
  prospections Prospection[]
  resetTokens  PasswordResetToken[]
  sequences    EmailSequence[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Anti força-bruta no login, chave "login:<email>". Mesma mecânica do playa-quadra.
model RateLimit {
  key         String    @id
  fails       Int       @default(0)
  firstAt     DateTime
  lockedUntil DateTime?
}

// Categorias CNAE que importamos. `enabled=false` tira da ingestão sem apagar dados.
model CnaeCategory {
  code        String     @id // 7 dígitos, ex "5611201"
  label       String
  group       String // FOOD | BEAUTY | HEALTH | FITNESS | PET | RETAIL | SERVICES
  valueWeight Int        @default(10) // 0–25, entra no score
  enabled     Boolean    @default(true)
  businesses  Business[]
}

// Um estabelecimento (dados públicos do CNPJ da Receita Federal).
// Contatos só chegam ao cliente após unlock (ver src/lib/leads.ts).
model Business {
  id                String         @id @default(cuid())
  cnpj              String         @unique // 14 dígitos
  cnpjBasico        String // 8 primeiros dígitos (join com o arquivo Empresas)
  razaoSocial       String         @default("")
  nomeFantasia      String         @default("")
  displayName       String // nomeFantasia || razão social limpa
  cnaeCode          String
  cnae              CnaeCategory   @relation(fields: [cnaeCode], references: [code])
  isMatriz          Boolean        @default(true)
  porte             String? // código de porte da RFB ("01" ME etc.)
  openedAt          DateTime? // início de atividade
  street            String         @default("")
  bairro            String // normalizado (Title Case)
  cep               String         @default("")
  phone1            String         @default("") // ddd+numero, só dígitos
  phone2            String         @default("")
  email             String         @default("")
  presenceClass     PresenceClass  @default(UNKNOWN)
  presenceCheckedAt DateTime? // null = ainda na fila do enrichment
  presenceEvidence  Json? // {provider, query, results:[{url,title,matchedAs}]}
  websiteUrl        String         @default("")
  socialUrl         String         @default("")
  score             Int            @default(0)
  // Visitas reais à demo (beacon JS: robôs de pré-visualização e a equipe logada não contam)
  demoViewCount     Int            @default(0)
  demoLastViewAt    DateTime?
  // Pediu para não ser contatado (LGPD): sai da fila e de todos os exports
  optOutAt          DateTime?
  ingestRef         String // dump de origem, ex "2026-06"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  prospection       Prospection?
  demoSite          DemoSite?
  demoViews         DemoView[]
  emailSequence     EmailSequence?

  @@index([presenceClass, score(sort: Desc)]) // query principal do dashboard
  @@index([bairro])
  @@index([cnaeCode])
  @@index([presenceCheckedAt]) // fila do enrichment
  @@index([cnpjBasico]) // fase B do import
  @@index([demoLastViewAt]) // "abriu a demo" na fila
}

// Uma visita à demo. channel = de onde veio o link (?c=e e-mail, ?c=w WhatsApp).
// Visitas do mesmo estabelecimento em menos de 30 min contam uma vez só.
model DemoView {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel    String   @default("") // "email" | "whatsapp" | ""
  at         DateTime @default(now())

  @@index([businessId, at])
}

// E-mails que nunca mais recebem contato (respondeu SAIR, pediu remoção),
// valendo para TODOS os CNPJs que usam o endereço. Sempre lowercase.
model SuppressedEmail {
  email     String   @id
  reason    String   @default("")
  createdAt DateTime @default(now())
}

// Registro do CRM de prospecção: no máximo UM por estabelecimento (compartilhado
// pela equipe). Sem registro = lead "novo"/não trabalhado.
model Prospection {
  id             String     @id @default(cuid())
  businessId     String     @unique
  business       Business   @relation(fields: [businessId], references: [id])
  status         LeadStatus @default(CONTATADO)
  notes          String     @default("")
  nextFollowUpAt DateTime? // próximo retorno combinado (data, meio-dia BRT)
  updatedById    String?
  updatedBy      User?      @relation(fields: [updatedById], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, updatedAt])
  @@index([nextFollowUpAt])
}

// Personalização/publicação do site de um estabelecimento. Sem linha aqui,
// a demo em /s/[slug] é 100% gerada dos dados + tema do segmento. A linha é
// criada quando o admin personaliza ou publica (cliente pagante).
model DemoSite {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id])
  slug         String   @unique // pode ser encurtado na venda (ex.: padaria-estrela)
  published    Boolean  @default(false) // true = pagante: sem faixa de demo, indexável
  headline     String   @default("") // overrides; vazio = default do tema
  about        String   @default("")
  hours        String   @default("")
  instagram    String   @default("")
  whatsapp     String   @default("") // se diferente do phone1 da RFB
  photoUrls    Json? // fase 2: fotos do cliente
  customDomain String   @default("") // apontado manualmente na Vercel (ver README)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Execuções dos scripts de ingestão/enriquecimento (checkpoint + auditoria).
model IngestionRun {
  id             String    @id @default(cuid())
  kind           RunKind
  sourceRef      String // ex "2026-06"
  status         RunStatus @default(RUNNING)
  checkpoint     Json? // {file: "Estabelecimentos3", line: 1234567}
  processedLines BigInt    @default(0)
  affectedRows   Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  error          String?
}

// ===== Assistente de vendas (SDR) por e-mail — src/lib/sdr/ =====

// Configuração única (id=1). Começa DESLIGADO: só envia depois que o admin liga.
model SdrConfig {
  id                Int       @id @default(1)
  enabled           Boolean   @default(false)
  pausedReason      String    @default("") // pausa automática (ex.: muitos e-mails voltando)
  rampStartedAt     DateTime? // 1º dia ligado: base do aquecimento (10 → 20 → 30 → máx/dia)
  dailyCapMax       Int       @default(40)
  bookingUrl        String    @default("") // link de agendamento (Cal.com / Google Agenda)
  nextSendNotBefore DateTime? // espaçamento aleatório entre envios
  imapUidValidity   BigInt? // estado da leitura da caixa de entrada
  imapLastUid       Int       @default(0)
  lastRunAt         DateTime?
  lastError         String    @default("")
  updatedAt         DateTime  @updatedAt
}

// Uma sequência (até 3 e-mails: D0, D3, D7) por estabelecimento.
model EmailSequence {
  id             String         @id @default(cuid())
  businessId     String         @unique
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email          String // destino (lowercase)
  status         SequenceStatus @default(ACTIVE)
  step           Int            @default(0) // quantos e-mails já foram enviados
  nextSendAt     DateTime       @default(now())
  subject        String         @default("") // assunto do 1º e-mail (os seguintes são "Re:")
  firstMessageId String         @default("") // para manter tudo na mesma conversa
  lastMessageId  String         @default("")
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  endedAt        DateTime?
  messages       EmailMessage[]

  @@index([status, nextSendAt])
}

// Log de cada e-mail enviado ou recebido na sequência.
model EmailMessage {
  id          String           @id @default(cuid())
  sequenceId  String
  sequence    EmailSequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  direction   MessageDirection
  step        Int? // 1..3 nos enviados
  messageId   String           @unique // Message-ID do e-mail
  subject     String           @default("")
  fromAddr    String           @default("")
  body        String           @default("") // texto (respostas: sem a parte citada, até 4 mil caracteres)
  kind        ReplyKind? // só nas recebidas
  at          DateTime         @default(now())
  handledAt   DateTime? // resposta humana tratada (aba Respostas)
  handledById String?

  @@index([direction, kind, handledAt])
  @@index([direction, at])
}
